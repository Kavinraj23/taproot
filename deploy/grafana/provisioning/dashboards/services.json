          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Valkey keyspace",
      "description": "Cache hits and misses per second, and keys evicted for lack of memory.",
      "gridPos": {
        "x": 0,
        "y": 22,
