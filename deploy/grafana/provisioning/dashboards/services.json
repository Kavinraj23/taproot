    {
      "id": 8,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "Messages waiting per consumer group and topic (end of the topic minus the group's committed offset). Climbing lag means messages arrive faster than the group handles them: the kafkaQueueProblems scenario.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "taproot-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "taproot-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, concat(labels['group'], ' / ', labels['topic']) AS series, max(value) AS value\nFROM taproot.metrics\nWHERE metric IN ('kafka_consumergroup_lag') AND $__timeFilter(ts)\nGROUP BY time, series\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.series}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Kafka messages in vs consumed",
      "description": "Messages written per second per topic, and committed (consumed) per second per group.",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "taproot-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "taproot-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, concat('in: ', labels['topic']) AS series, avg(value) AS value\nFROM taproot.metrics\nWHERE metric IN ('kafka_topic_messages_per_sec') AND $__timeFilter(ts)\nGROUP BY time, series\nORDER BY time"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "taproot-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, concat('consumed: ', labels['group']) AS series, avg(value) AS value\nFROM taproot.metrics\nWHERE metric IN ('kafka_consumergroup_consumed_per_sec') AND $__timeFilter(ts)\nGROUP BY time, series\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "displayName": "${__field.labels.series}",
