        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.series}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Valkey memory",
      "description": "Memory used. maxmemory 0 means no limit, so it isn't drawn.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "taproot-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "taproot-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, 'used' AS series, avg(value) AS value\nFROM taproot.metrics\nWHERE metric IN ('valkey_used_memory_bytes') AND $__timeFilter(ts)\nGROUP BY time, series\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "displayName": "${__field.labels.series}",
          "custom": {
            "lineWidth": 2,
