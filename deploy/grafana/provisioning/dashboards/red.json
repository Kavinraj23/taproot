{
  "uid": "taproot-red",
  "title": "Service RED",
  "tags": [
    "taproot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Server and consumer spans per service, averaged over each minute. Some services record a request as two nested server spans (frontend, flagd), so read these as relative, not exact (decision 0008, task 5).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "taproot-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "taproot-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT minute AS time, service AS series, sum(requests) / 60 AS value\nFROM taproot.spans_red_1m\nWHERE $__timeFilter(minute) AND minute < toStartOfMinute(now())\nGROUP BY time, series\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "displayName": "${__field.labels.series}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error %",
      "description": "Share of each service's requests whose span status is error, per minute.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "taproot-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "taproot-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT minute AS time, service AS series, 100 * sum(errors) / sum(requests) AS value\nFROM taproot.spans_red_1m\nWHERE $__timeFilter(minute) AND minute < toStartOfMinute(now())\nGROUP BY time, series\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "${__field.labels.series}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency",
      "description": "95th percentile request duration per service, per minute (t-digest, approximate).",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "taproot-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "taproot-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT minute AS time, service AS series, quantilesTDigestMerge(0.95)(duration_q)[1] / 1e6 AS value\nFROM taproot.spans_red_1m\nWHERE $__timeFilter(minute) AND minute < toStartOfMinute(now())\nGROUP BY time, series\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "displayName": "${__field.labels.series}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Operations",
      "description": "Every operation over the selected range: requests, error %, and duration percentiles in ms.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "taproot-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "taproot-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT service, operation, sum(requests) AS total_requests,\n       round(100 * sum(errors) / sum(requests), 2) AS error_pct,\n       round(quantilesTDigestMerge(0.5, 0.95, 0.99)(duration_q)[1] / 1e6, 1) AS p50_ms,\n       round(quantilesTDigestMerge(0.5, 0.95, 0.99)(duration_q)[2] / 1e6, 1) AS p95_ms,\n       round(quantilesTDigestMerge(0.5, 0.95, 0.99)(duration_q)[3] / 1e6, 1) AS p99_ms,\n       round(max(duration_max_ns) / 1e6, 1) AS max_ms\nFROM taproot.spans_red_1m\nWHERE $__timeFilter(minute)\nGROUP BY service, operation\nORDER BY service, total_requests DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "error_pct",
            "desc": true
          }
        ]
      }
    }
  ]
}
