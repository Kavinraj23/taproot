{
  "uid": "taproot-host-cpu",
  "title": "Host CPU",
  "tags": ["taproot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Host CPU usage",
      "description": "host_cpu_usage_percent from taproot.metrics: one line per host, averaged into buckets sized to the zoom level.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 12 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "taproot-clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "taproot-clickhouse" },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, labels['host'] AS host, avg(value) AS cpu\nFROM taproot.metrics\nWHERE metric = 'host_cpu_usage_percent' AND $__timeFilter(ts)\nGROUP BY time, host\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "displayName": "${__field.labels.host}",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
